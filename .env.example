PORT=5000
MongoDb_Connection_String=mongodb+srv://USER:PASSWORD@HOST/DATABASE
secretKey=change-this-to-a-long-random-secret
projectName=Batting

# Firebase Admin credentials.
# Prefer FIREBASE_SERVICE_ACCOUNT_JSON on deployed platforms.
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"your-firebase-project-id","private_key_id":"","private_key":"-----BEGIN PRIVATE KEY-----\\n...\\n-----END PRIVATE KEY-----\\n","client_email":"firebase-adminsdk@example.iam.gserviceaccount.com","client_id":""}
# Local-only alternative:
# FIREBASE_SERVICE_ACCOUNT_PATH=./firebase-service-account.json

# Optional Redis queue. If unavailable, the API starts and disables the chat queue.
REDIS_HOST=127.0.0.1
REDIS_PORT=6379

# Optional email sender used by util/emailService.js.
EMAIL=no-reply@example.com
